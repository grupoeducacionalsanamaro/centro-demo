---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { obtenerArticulos, type Articulo } from '../../lib/articulos';

export async function getStaticPaths() {
  const articulos = await obtenerArticulos();
  return articulos.map((a) => ({ params: { slug: a.slug }, props: { a, otros: articulos.filter((o) => o.slug !== a.slug).slice(0, 2) } }));
}
interface Props { a: Articulo; otros: Articulo[] }
const { a, otros } = Astro.props;
const { Content } = await render(a);
const imagenOg = a.data.imagen ? `/images/${a.data.imagen}.webp` : undefined;
---
<Base titulo={a.data.titulo} descripcion={a.data.descripcion} imagenOg={imagenOg}>
  <article>
    <header class="art-cabecera">
      <div class="contenedor contenedor--angosto">
        <nav class="migas" aria-label="Ruta de navegación">
          <ol>
            <li><a href="/">Inicio</a></li>
            <li><a href="/educacion">Educación</a></li>
            <li><span aria-current="page">{a.especialidadNombre}</span></li>
          </ol>
        </nav>
        <a href={`/educacion?especialidad=${a.data.especialidad}`} class="etiqueta">{a.especialidadNombre}</a>
        <h1>{a.data.titulo}</h1>
        <p class="art-cabecera__bajada">{a.data.descripcion}</p>
        <div class="autor">
          {a.autor && <img src={`/images/${a.autor.imagen}.webp`} width="48" height="48" alt="" />}
          <div>
            <p class="autor__nombre">Por {a.autor?.nombre}{a.autor && <span>, {a.autor.titulo.toLowerCase()}</span>}</p>
            <p class="autor__meta">
              <time datetime={a.fechaIso}>{a.fechaTexto}</time>
              <span aria-hidden="true">·</span>
              <span><Icono nombre="reloj" tamano={15} /> {a.minutosLectura} min de lectura</span>
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class="contenedor contenedor--angosto">
      {a.data.imagen && (
        <img
          class="art-imagen"
          src={`/images/${a.data.imagen}.webp`}
          srcset={`/images/${a.data.imagen}-640.webp 640w, /images/${a.data.imagen}.webp 1344w`}
          sizes="(min-width: 832px) 768px, 100vw"
          width="1344" height="752"
          alt={a.data.imagenAlt ?? ''}
          fetchpriority="high"
        />
      )}
      <div class="prosa">
        <Content />
      </div>

      <div class="aviso aviso--info aviso-educativo" role="note">
        <Icono nombre="info" />
        <p><strong>Este contenido es educativo y no reemplaza una evaluación profesional.</strong></p>
      </div>

      {a.autor && (
        <div class="tarjeta cta-art">
          <p>¿Quieres una evaluación personalizada? Agenda con {a.autor.nombre}.</p>
          <a class="boton boton--primario" href={`/agendar?especialidad=${a.data.especialidad}&profesional=${a.autor.id}`}>
            <Icono nombre="calendario-check" tamano={20} /> Agendar hora
          </a>
        </div>
      )}
    </div>
  </article>

  {otros.length > 0 && (
    <section class="seccion seccion--alterna" aria-labelledby="otros-titulo">
      <div class="contenedor">
        <h2 id="otros-titulo">Sigue leyendo</h2>
        <div class="grilla grilla--2">
          {otros.map((o) => <TarjetaArticulo a={o} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .art-cabecera { padding-block: 28px 32px; }
  .art-cabecera .etiqueta { text-decoration: none; margin-bottom: 14px; }
  .art-cabecera h1 { font-size: clamp(1.9rem, 4.5vw, 2.75rem); }
  .art-cabecera__bajada { font-size: 1.15rem; color: var(--gris); }
  .autor { display: flex; gap: 12px; align-items: center; margin-top: 20px; }
  .autor img { border-radius: 50%; background: var(--verde-claro); }
  .autor p { margin: 0; }
  .autor__nombre { font-weight: 600; }
  .autor__nombre span { font-weight: 400; color: var(--gris); }
  .autor__meta { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; font-size: 0.875rem; color: var(--gris); }
  .autor__meta > * { white-space: nowrap; }
  .autor__meta span { display: inline-flex; gap: 4px; align-items: center; }
  .art-imagen { border-radius: var(--radio); width: 100%; margin-bottom: 32px; }
  .aviso-educativo { margin-block: 40px 24px; }
  .cta-art { padding: 24px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; margin-bottom: 64px; }
  .cta-art p { margin: 0; font-weight: 600; font-family: var(--fuente-titulos); }
</style>
